# dependencies
node_modules/

# build output
client/dist/
client/.vite/

# environment / secrets
.env
.env.*
*.env
!.env.example

server/.env
server/.env.*
!server/.env.example

client/.env
client/.env.*
!client/.env.example

# demo mode is local-only and must never be used in a hosted build
client/.env.demo

# certs / keys
*.pem
*.key
*.crt
*.p12

# uploads (multer local disk in dev; replace with S3/object storage before hosting)
server/uploads/
server/storage/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# never allow non-npm lockfiles (CLAUDE.md hard rule)
pnpm-lock.yaml
yarn.lock
bun.lockb
