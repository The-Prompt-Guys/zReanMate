# Copy to client/.env to override. client/.env is gitignored.
#
# Per-flow prototype switches — see src/mock/mode.js.
#
# A flow in prototype mode reads src/mock/fixtures.js and never calls the API.
# A flow that is live calls the API and has no fixture fallback.
#
# Resolution, per flow, first match wins:
#   1. VITE_PROTOTYPE_<FLOW>
#   2. VITE_PROTOTYPE          (only for flows not yet migrated)
#   3. the flow's own default
#
# These are build-time constants: changing one needs a dev-server restart.

# The dial for every flow still on fixtures.
# VITE_PROTOTYPE=true

# Migrated flows. These default to live and do NOT follow VITE_PROTOTYPE —
# set one explicitly to put that flow back on fixtures for design review.
# VITE_PROTOTYPE_AUTH=false
# VITE_PROTOTYPE_KITS=false

# Not migrated yet; these follow VITE_PROTOTYPE unless set.
# VITE_PROTOTYPE_STUDY=true
# VITE_PROTOTYPE_CHAT=true
# VITE_PROTOTYPE_QUIZ=true
# VITE_PROTOTYPE_PRACTICE=true
# VITE_PROTOTYPE_FLASHCARDS=true
# VITE_PROTOTYPE_CLASSES=true
# VITE_PROTOTYPE_ASSIGNMENTS=true
# VITE_PROTOTYPE_PROFILE=true
