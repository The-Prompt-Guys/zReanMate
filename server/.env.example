# Copy to server/.env and fill in. server/.env is gitignored.

NODE_ENV=development
PORT=4000

# PostgreSQL 16 with the uuid-ossp, pg_trgm and vector (pgvector) extensions.
# pgvector is NOT bundled with a stock Postgres install — see docs/SCHEMA.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reanmate

# Vite dev server origin. Comma-separate to add more.
# Must be exact — cookies forbid a wildcard origin.
CORS_ORIGINS=http://localhost:5173

JSON_BODY_LIMIT=1mb

# Change this. Any value works in dev; a leaked secret forges sessions in prod.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# multer + local disk in dev
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400

OTP_TTL_MINUTES=10

# Leave unset until a key exists — the AI layer falls back to the mock provider
# and logs one warning at boot (CLAUDE.md, AI layer).
# ANTHROPIC_API_KEY=
